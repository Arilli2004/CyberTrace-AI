# Environment Variables — CyberTrace AI
# Copy this file to .env and fill in your values

# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=CyberTrace AI
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://cybertrace:cybertrace123@localhost:5432/cybertrace_db
POSTGRES_USER=cybertrace
POSTGRES_PASSWORD=cybertrace123
POSTGRES_DB=cybertrace_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096

# ─── File Storage ────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=500
ALLOWED_EXTENSIONS=evtx,log,csv,json,xml

# ─── Backend ─────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Frontend ────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api
VITE_APP_NAME=CyberTrace AI
